rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each person can read and write only their own synced data
    match /users/{uid}/sync/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // challenge scores: anyone signed in can read, you can only write your own entry
    match /challenges/{cid}/entries/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // usage counters are written by the server only
    match /users/{uid}/usage/{doc} {
      allow read, write: if false;
    }
  }
}
